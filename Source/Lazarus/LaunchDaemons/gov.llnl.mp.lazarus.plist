<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>gov.llnl.mp.lazarus</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/sbin/lazarus</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Library/Logs/mp_lazarus.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/mp_lazarus.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
