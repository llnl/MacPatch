#!/bin/sh

# ***************************************************************************************
# PostFlight Script for MacPatch Client Installer
# ver 3.11
# Created By Charles Heizer @ LLNL
#
# Improvements in v3.8:
# - Fixed critical function name typo (sIload -> isIload)
# - Improved security with proper file permissions (removed chmod 777)
# - Fixed missing path prefix bug
# - Enhanced error handling throughout
# - Modernized syntax (replaced backticks with $(...))
# - Simplified boolean validation logic
# - Added better safety checks for file operations
# - Consistent quoting and code style
#
# Improvements in v3.9:
# - Upgraded setupPyVirtEnv to Python 3 with venv module
# - Removed deprecated easy_install and old virtualenv methods
# - Added macOS 10.12+ compatibility for Xcode CLI Tools installation
# - Improved Python virtual environment creation with fallback support
# - Better error messages and progress feedback
# - Added automatic Python 2 to Python 3 migration
#
# Improvements in v3.10:
# - Added skip whats new popup to script
#
# Improvements in v3.11:
# - Strip com.apple.quarantine from installed plists and helper binaries.
#   macOS 27 refuses to bootstrap a quarantined LaunchDaemon and reports only
#   "Bootstrap failed: 5: Input/output error". Earlier releases tolerated it,
#   so payloads built before 27 can carry the attribute for months unnoticed.
# - Replaced deprecated "launchctl load -w" with bootout/bootstrap, including
#   a wait for the label to be released (bootout is asynchronous; bootstrapping
#   during cleanup returns error 37, surfaced as the same opaque error 5).
# - Clear any stale disabled-database entry before bootstrapping. That database
#   survives uninstalls and silently blocks a reinstall.
# - Verify each daemon is registered after loading instead of assuming success.
# - Cover all five daemon plists for ownership/permissions, not just two.
# ***************************************************************************************

MP_ROOT="/Library/MacPatch"
MP_ROOT_CLIENT="${MP_ROOT}/Client"

# Script Parent Dir Path
SRC="$(dirname "$0")"

# Current logged in User ID
# consoleUserID at login window is 0
consoleUserID=$(stat -f%u /dev/console)

isIload ()
{
	pid=$(ps -e | grep iLoadAssistant | grep -v grep | awk '{print $1}')
	echo "$pid"
}

# Remove the quarantine attribute that blocks launchd from loading a job.
# Only com.apple.quarantine is removed; com.apple.provenance is left intact
# so the system can still attribute the file to its installer package.
stripQuarantine() {
	if [ -e "$1" ]; then
		/usr/bin/xattr -d com.apple.quarantine "$1" 2>/dev/null
		if /usr/bin/xattr -p com.apple.quarantine "$1" >/dev/null 2>&1; then
			echo "Warning: could not clear com.apple.quarantine on $1"
		fi
	fi
}

setOwner() {
	if [ -f "$1" ]; then
		/usr/sbin/chown -R root:wheel "$1"
		stripQuarantine "$1"
	fi
}

setOwnerAndPerms() {
	if [ -f "$1" ]; then
		/usr/sbin/chown root:wheel "$1"
		/bin/chmod 0644 "$1"
		stripQuarantine "$1"
	fi
}

# Privileged helper binaries need the exec bit; a plist must not have it.
setHelperOwnerAndPerms() {
	if [ -f "$1" ]; then
		/usr/sbin/chown root:wheel "$1"
		/bin/chmod 0755 "$1"
		stripQuarantine "$1"
		if ! /usr/bin/codesign --verify --strict "$1" 2>/dev/null; then
			echo "Warning: code signature invalid on $1"
		fi
	fi
}

setDirOwnerAndPerms() {
	if [ -d "$1" ]; then
		/usr/sbin/chown -R root:wheel "$1"
		/bin/chmod 0755 "$1"
	fi
}

existsAndDelete ()
{
	if [ -f "$1" ]; then
		echo "Removing (rm -f) file $1"
		rm -f "$1" 2>/dev/null
	elif [ -d "$1" ]; then
		echo "Removing (rm -rf) directory $1"
		rm -rf "$1" 2>/dev/null
	fi
}

function runClientActions
{
	# Check in
	/Library/MacPatch/Client/MPAgent checkIn
	sleep 1
}

function removeOldRegFiles
{
	existsAndDelete "/Library/Application Support/MacPatch/MacPatch.keychain"
	existsAndDelete "/Library/Application Support/MacPatch/.keyHash"
	existsAndDelete "/Library/Application Support/MacPatch/.MacPatch.keychain"
	existsAndDelete "/Library/Application Support/MacPatch/gov.llnl.mp.plist"
}

validateBoolean() {
	local value="$1"
	if [ "$value" = "1" ] || [ "$value" = "0" ]; then
		echo "$value"
	else
		echo "0"
	fi
}

getServerAddress() {
	local server=""
	if [ -f "/Library/Application Support/MacPatch/gov.llnl.mpagent.plist" ]; then
		server=$(defaults read "/Library/Application Support/MacPatch/gov.llnl.mpagent.plist" MPServerAddress 2>/dev/null || echo "")
	fi
	echo "$server"
}

installLazarus() {
	echo "Checking for Lazarus installation..."

	# Check if lazarus is already installed
	if [ -f "/usr/local/sbin/lazarus" ]; then
		echo "Lazarus is already installed at /usr/local/sbin/lazarus"
		return 0
	fi

	echo "Lazarus not found, attempting to download and install..."

	# Get server address from agent plist
	local serverAddress=$(getServerAddress)

	if [ -z "$serverAddress" ]; then
		echo "Warning: Could not determine server address from agent plist. Skipping Lazarus installation."
		return 1
	fi

	echo "Using server address: $serverAddress"

	# Construct download URL
	local lazarusURL="https://${serverAddress}/mp-content/lazarus/pkg/MPLazarus.pkg"
	local tmpPkg="/private/tmp/MPLazarus.pkg"

	# Clean up any existing temp package
	rm -f "$tmpPkg"

	# Download the package
	echo "Downloading Lazarus from: $lazarusURL"
	if /usr/bin/curl -f -s -L -o "$tmpPkg" "$lazarusURL" 2>/dev/null; then
		echo "Download successful"

		# Verify the download is a valid package
		if /usr/sbin/pkgutil --check-signature "$tmpPkg" >/dev/null 2>&1 || [ -f "$tmpPkg" ]; then
			echo "Installing Lazarus package..."
			if /usr/sbin/installer -pkg "$tmpPkg" -target / 2>/dev/null; then
				echo "Lazarus installed successfully"
				rm -f "$tmpPkg"
				return 0
			else
				echo "Error: Failed to install Lazarus package"
				rm -f "$tmpPkg"
				return 1
			fi
		else
			echo "Error: Downloaded file is not a valid package"
			rm -f "$tmpPkg"
			return 1
		fi
	else
		echo "Error: Failed to download Lazarus from $lazarusURL"
		rm -f "$tmpPkg"
		return 1
	fi
}

# ******************************************************************
# LaunchDaemon loading
#
# "launchctl load -w" is deprecated and reports success even when the job
# was rejected. bootstrap reports failure properly, but needs the label to
# be free first: bootout schedules cleanup several seconds after SIGTERM,
# and bootstrapping into that window returns error 37, which launchctl
# surfaces as "Bootstrap failed: 5: Input/output error".

waitForLabelGone() {
	local label="$1"
	local i=0
	while [ "$i" -lt 20 ]; do
		if ! /bin/launchctl print "system/${label}" >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.5
		i=$((i + 1))
	done
	return 1
}

loadDaemon() {
	local label="$1"
	local plist="/Library/LaunchDaemons/${label}.plist"

	if [ ! -f "$plist" ]; then
		echo "Skipping ${label}: ${plist} not present"
		return 0
	fi

	# Guard against a payload that arrived with the attribute still set.
	stripQuarantine "$plist"

	if /bin/launchctl print "system/${label}" >/dev/null 2>&1; then
		echo "Unloading existing ${label}"
		/bin/launchctl bootout "system/${label}" >/dev/null 2>&1
		if ! waitForLabelGone "$label"; then
			echo "Warning: ${label} still registered after bootout"
		fi
	fi

	# A stale disabled-database entry from a previous install would otherwise
	# block this silently. The database persists across uninstalls.
	/bin/launchctl enable "system/${label}" 2>/dev/null

	if /bin/launchctl bootstrap system "$plist" 2>/dev/null; then
		echo "Loaded ${label}"
	else
		echo "Error: bootstrap failed for ${label}"
		LOAD_FAILED=1
		return 1
	fi

	if ! /bin/launchctl print "system/${label}" >/dev/null 2>&1; then
		echo "Error: ${label} not registered after bootstrap"
		LOAD_FAILED=1
		return 1
	fi

	return 0
}

LOAD_FAILED=0

# ******************************************************************
# Set Up Python Virtual Environment
# Compatible with macOS 10.12+ and modern macOS versions
# Updated to use Python 3 and modern tools

function setupPyVirtEnv
{
	LIBDIR="/Library/MacPatch/Client/lib"
	VENV_PATH="${LIBDIR}/python"

	echo "Setting up Python virtual environment..."

	# Check for Python 3
	if ! command -v python3 >/dev/null 2>&1; then
		echo "Error: Python 3 is not installed. Python 3 is required."
		echo "On macOS 10.12, Python 3 must be installed separately (e.g., from python.org or Homebrew)"
		return 1
	fi

	PYTHON_VERSION=$(python3 --version 2>&1 | awk '{print $2}')
	echo "Using Python version: ${PYTHON_VERSION}"

	# Install Xcode Command Line Tools if needed
	# Compatible with macOS 10.12+ (Sierra and later)
	if ! xcode-select -p >/dev/null 2>&1; then
		echo "Installing Xcode Command Line Tools..."

		# Create placeholder file for softwareupdate method
		touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress

		# Find the Command Line Tools package
		# Use -l for compatibility with macOS 10.12
		CLT_LABEL=$(softwareupdate -l 2>/dev/null | grep "\*.*Command Line" | head -n 1 | awk -F"*" '{print $2}' | sed -e 's/^ *//' | tr -d '\n')

		if [ -n "$CLT_LABEL" ]; then
			echo "Installing: $CLT_LABEL"
			echo "This may take several minutes..."
			softwareupdate -i "$CLT_LABEL" --verbose

			# Wait for installation to complete
			sleep 5
		else
			# Try interactive method as fallback
			echo "No Command Line Tools found via softwareupdate"
			echo "Attempting interactive installation..."
			xcode-select --install 2>/dev/null

			echo "A dialog box should appear. Please complete the installation."
			echo "Waiting up to 2 minutes for installation to complete..."

			# Wait for user to complete interactive installation
			for i in {1..60}; do
				if xcode-select -p >/dev/null 2>&1; then
					echo "Xcode Command Line Tools installed successfully"
					break
				fi
				sleep 2
			done
		fi

		rm -f /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress

		# Final check
		if ! xcode-select -p >/dev/null 2>&1; then
			echo "Warning: Could not install Xcode Command Line Tools automatically"
			echo "Please install manually by running: xcode-select --install"
			echo "Or download from: https://developer.apple.com/download/more/"
		fi
	else
		echo "Xcode Command Line Tools already installed at: $(xcode-select -p)"
	fi

	# Remove old virtualenv if it exists and was created with Python 2
	if [ -d "$VENV_PATH" ]; then
		if [ -f "${VENV_PATH}/bin/python" ]; then
			VENV_PYTHON_VERSION=$("${VENV_PATH}/bin/python" --version 2>&1)
			if [[ "$VENV_PYTHON_VERSION" == *"Python 2"* ]]; then
				echo "Removing old Python 2 virtual environment..."
				rm -rf "$VENV_PATH"
			fi
		fi
	fi

	# Create virtual environment using Python 3's built-in venv module
	if [ ! -d "$VENV_PATH" ]; then
		echo "Creating Python 3 virtual environment at ${VENV_PATH}..."
		cd "$LIBDIR" || return 1

		if ! python3 -m venv python 2>/dev/null; then
			# venv might not be available on some Python 3 installations on 10.12
			# Fall back to trying virtualenv package if venv fails
			echo "Built-in venv failed, trying virtualenv package..."

			if ! command -v virtualenv >/dev/null 2>&1; then
				echo "Installing virtualenv package..."
				python3 -m pip install --user virtualenv --quiet 2>/dev/null || pip3 install --user virtualenv --quiet
			fi

			if command -v virtualenv >/dev/null 2>&1; then
				virtualenv -p python3 python
			else
				echo "Error: Failed to create virtual environment with both venv and virtualenv"
				return 1
			fi
		fi
	else
		echo "Virtual environment already exists at ${VENV_PATH}"
	fi

	# Activate the virtual environment
	if [ -f "${VENV_PATH}/bin/activate" ]; then
		# shellcheck disable=SC1091
		source "${VENV_PATH}/bin/activate"
	else
		echo "Error: Virtual environment activation script not found"
		return 1
	fi

	# Upgrade pip to latest version
	echo "Upgrading pip..."
	python3 -m pip install --upgrade pip --quiet 2>/dev/null || echo "Warning: Could not upgrade pip"

	# Install required modules
	MODS="biplist requests xattr"
	echo "Installing Python modules: $MODS"

	for mod in $MODS; do
		echo "  Installing $mod..."
		if ! pip install --quiet "$mod" 2>/dev/null; then
			echo "  Warning: Failed to install $mod"
			# Continue with other modules even if one fails
		fi
	done

	# Deactivate virtual environment
	deactivate

	# Set proper permissions
	chown -R root:wheel "$VENV_PATH"
	chmod -R 755 "$VENV_PATH"

	echo "Python virtual environment setup complete"
	return 0
}

# ******************************************************************
# Set owner & permissions
setOwnerAndPerms /Library/LaunchDaemons/gov.llnl.mp.agent.plist
setOwnerAndPerms /Library/LaunchDaemons/gov.llnl.mp.helper.plist
setOwnerAndPerms /Library/LaunchDaemons/gov.llnl.mp.status.ui.plist
setOwnerAndPerms /Library/LaunchDaemons/gov.llnl.mp.updater.plist
setOwnerAndPerms /Library/LaunchAgents/gov.llnl.mp.status.plist
setHelperOwnerAndPerms /Library/PrivilegedHelperTools/gov.llnl.mp.helper
setHelperOwnerAndPerms /Library/PrivilegedHelperTools/gov.llnl.mp.status.ui

# Catch anything else the payload dropped in with the attribute still set.
for f in /Library/LaunchDaemons/gov.llnl.mp.*.plist /Library/LaunchAgents/gov.llnl.mp.*.plist; do
	[ -f "$f" ] && stripQuarantine "$f"
done

if [ ! -d "/Library/Application Support/MPClientStatus" ]; then
	mkdir -p "/Library/Application Support/MPClientStatus"
	chown root:admin "/Library/Application Support/MPClientStatus"
	chmod 775 "/Library/Application Support/MPClientStatus"
fi

agentPrefs="/Library/Application Support/MacPatch/gov.llnl.mpagent"
agentPrefsPlist="/Library/Application Support/MacPatch/gov.llnl.mpagent.plist"

# ******************************************************************
# Set Agent Plist data ...
#

if [ ! -d "/Library/Application Support/MacPatch" ]; then
	mkdir -p "/Library/Application Support/MacPatch"
fi

# Add Initial Agent Config Data
if [ ! -f "/Library/Application Support/MacPatch/gov.llnl.mpagent.plist" ]; then
	cp "${SRC}/gov.llnl.mpagent.plist" "/Library/Application Support/MacPatch/gov.llnl.mpagent.plist"
fi

# Add new option to stage patches
# defaults write "${agentPrefsPlist}" PreStageUpdates -bool YES

# Copy in client version info
if [ -e "${SRC}/.mpVersion.plist" ]; then
	cp "${SRC}/.mpVersion.plist" "/Library/MacPatch/Client/.mpVersion.plist"
fi

# Set Permissions
chown -R root:admin "/Library/Application Support/MacPatch"
chmod -R 775 "/Library/Application Support/MacPatch"

# ******************************************************************
# Run Agent Components to populate DB with current info ************
#

if [ ! -d "/Library/MacPatch/Client/lib" ]; then
	mkdir -p "/Library/MacPatch/Client/lib"
fi
chown -R root:wheel "/Library/MacPatch/Client/lib"
chmod 755 "/Library/MacPatch/Client/lib"

# ******************************************************************
# Install Included Profiles - With PRE prefix 	********************
#
if [ -d "${SRC}/profiles" ]; then
	# Find all mobileconfig files not beginning with post
	# will install post profiles at the end of the script
	find "${SRC}/profiles" -type f ! -name "post*.mobileconfig" -print0 | while IFS= read -r -d '' file
	do
		if [ -f "$file" ]; then
			/usr/bin/profiles -I -F "$file" 2>/dev/null || echo "Warning: Failed to install profile: $file"
		fi
	done
fi

# ******************************************************************
# Add MacPatch Client Plugins if included **************************
#
if [ -d "${SRC}/Plugins" ]; then
	if [ ! -d "/Library/MacPatch/Client/lib/PlugIns" ]; then
		mkdir -p "/Library/MacPatch/Client/lib/PlugIns"
	fi
	/usr/bin/find "${SRC}/Plugins" -name '*.bundle' -exec /bin/cp -r {} /Library/MacPatch/Client/lib/PlugIns/ \;
	chown -R root:wheel "/Library/MacPatch/Client/lib/PlugIns"
	chmod -R 755 "/Library/MacPatch/Client/lib/PlugIns"
fi

# ******************************************************************
# Add Server Public Key ********************************************
#
if [ -f "${SRC}/ServerPub.pem" ]; then
	mkdir -p "/Library/Application Support/MacPatch/.keys"
	cp "${SRC}/ServerPub.pem" "/Library/Application Support/MacPatch/.keys/ServerPub.pem"
	chmod 600 "/Library/Application Support/MacPatch/.keys/ServerPub.pem"
	chown root:wheel "/Library/Application Support/MacPatch/.keys/ServerPub.pem"
fi

# ******************************************************************
# Check for Provision Done file
if [ ! -e "/private/var/db/.MPProvisionDone" ]; then
	if ! /Library/MacPatch/Client/MPAgent provisionConfig; then
		echo "Error getting provisioning config. .MPProvisionBegin will not be created."
		rm -f /private/var/db/.MPProvisionBegin
	fi
fi

# ******************************************************************
# Copy in Skip Whats New File

if [ -e "${SRC}/.mpSkipWhatsNew" ]; then
	echo "Write, skipping whats new popup."
	touch "/private/tmp/.MPSkipWhatsNew"
	chmod 644 "/tmp/.MPSkipWhatsNew"
else
	/usr/bin/touch /private/tmp/.mpResetWhatsNew
	chmod 644 /private/tmp/.mpResetWhatsNew
fi

# ******************************************************************
# Install Lazarus if not present
installLazarus

# ******************************************************************
# Run Client Check-in
CLIENTID=$(/Library/MacPatch/Client/MPAgent clientID)

regEnabled=$(defaults read "${agentPrefsPlist}" registrationEnabled 2>/dev/null || echo "0")
regEnabled=$(validateBoolean "$regEnabled")

useAutoReg=$(defaults read "${agentPrefsPlist}" autoregEnabled 2>/dev/null || echo "0")
useAutoReg=$(validateBoolean "$useAutoReg")

useParking=$(defaults read "${agentPrefsPlist}" clientParkingEnabled 2>/dev/null || echo "0")
useParking=$(validateBoolean "$useParking")

if [ "$regEnabled" = "1" ]; then
	# Check to see if the client is already registered
	if ! /Library/MacPatch/Client/MPAgent register --status >/dev/null 2>&1; then
		sleep 1
		# Remove old reg files, since client is not registered
		removeOldRegFiles
		# If reg key file exists we use that
		# Register Client With Provided Key
		if [ -f "${SRC}/.mpreg.key" ]; then
			regFile="${SRC}/.mpreg.key"
			regKey=$(cat "$regFile")
			if /Library/MacPatch/Client/MPAgent register --key "$regKey"; then
				sleep 1
				runClientActions
			fi
		# If Autoreg is enabled we use it
		elif [ "$useAutoReg" = "1" ]; then
			if /Library/MacPatch/Client/MPAgent register; then
				sleep 1
				runClientActions
			fi
		# If clientParking is enabled we use it
		# we do not run any of the client actions
		elif [ "$useParking" = "1" ]; then
			/Library/MacPatch/Client/MPAgent register
			sleep 1
		fi
	fi
else
	# Run all of the normal client actions
	runClientActions
fi

# ******************************************************************
# Launch the Helper service  ***************************************
#

loadDaemon gov.llnl.mp.helper
loadDaemon gov.llnl.mp.status.ui

# ******************************************************************
# Launch the MPAgent service ***************************************
#
if [ -z "$(isIload)" ]; then
	# No iLoadAssistant
	loadDaemon gov.llnl.mp.agent
else
	echo "Running iLoad, apps will launch on reboot."
fi

# ******************************************************************
# Start LaunchAgent Apps *******************************************
#
if [ "$consoleUserID" != "0" ] && [ -f /Library/LaunchAgents/gov.llnl.mp.status.plist ]; then
	echo "Loading LaunchAgent for user ID: $consoleUserID"

	# Check if service is already loaded
	serviceLoaded=false
	if /bin/launchctl print "gui/$consoleUserID/gov.llnl.mp.status" >/dev/null 2>&1; then
		echo "Service gov.llnl.mp.status is already loaded"
		serviceLoaded=true
	fi

	# Load the service if not already loaded
	if [ "$serviceLoaded" = false ]; then
		# bootstrap first: it reports failure honestly, where load does not.
		if /bin/launchctl bootstrap "gui/$consoleUserID" /Library/LaunchAgents/gov.llnl.mp.status.plist 2>/dev/null; then
			echo "LaunchAgent loaded successfully using bootstrap"
		else
			# Fall back to asuser for older releases
			if /bin/launchctl asuser "$consoleUserID" /bin/launchctl load /Library/LaunchAgents/gov.llnl.mp.status.plist 2>/dev/null; then
				echo "LaunchAgent loaded successfully using asuser"
			else
				# Last resort: direct load (will load on next login if this fails)
				/bin/launchctl load /Library/LaunchAgents/gov.llnl.mp.status.plist 2>/dev/null || true
				echo "LaunchAgent will load on next user login"
			fi
		fi
		sleep 1
	fi

	# Force start the service using kickstart (always, even if already loaded)
	echo "Starting gov.llnl.mp.status service..."
	if /bin/launchctl kickstart -kp "gui/$consoleUserID/gov.llnl.mp.status" 2>/dev/null; then
		echo "Service started successfully with kickstart"
		sleep 1

		# Verify it's actually running
		if /bin/launchctl print "gui/$consoleUserID/gov.llnl.mp.status" 2>/dev/null | grep -q "state = running"; then
			echo "Verified: gov.llnl.mp.status is running"
		else
			echo "Warning: Service loaded but state may be 'not running' - will start on trigger"
		fi
	else
		echo "Kickstart failed, trying alternative start methods..."
		# Try direct start command
		if /bin/launchctl asuser "$consoleUserID" /bin/launchctl start gov.llnl.mp.status 2>/dev/null; then
			echo "Service started with asuser start"
		else
			echo "Warning: Could not force-start service. It will start on first trigger/login."
		fi
	fi
fi

# Without this, may have a hard time upgrading
pkgutil --forget gov.llnl.mp.agent.base
pkgutil --forget gov.llnl.macpatch.base

# ******************************************************************
# Install Included Profiles - With POST prefix 	********************
#
if [ -d "${SRC}/profiles" ]; then
	for file in "${SRC}"/profiles/post*.mobileconfig; do
		if [ -f "$file" ]; then
			/usr/bin/profiles -I -F "$file" 2>/dev/null || echo "Warning: Failed to install profile: $file"
		fi
	done
fi

# Post that agent software has been installed...
if [ -f /Library/MacPatch/Client/MPAgent ]; then
	/Library/MacPatch/Client/MPAgent agentInstall 2>/dev/null || echo "Warning: Could not post agent install notification"
	sleep 1
fi

touch /tmp/.mpagentinstalled
chmod 644 /tmp/.mpagentinstalled

# Kill the ClientStatus app, launchctl does not restart the app only the service
if [ -f "/private/tmp/clientStatusPID" ]; then
	curClientStatusPID=$(ps -ae | grep MPClientStatus | grep -v grep | awk '{ print $1 }')
	fileClientStatusPID=$(cat /private/tmp/clientStatusPID 2>/dev/null)

	if [ -n "$curClientStatusPID" ] && [ -n "$fileClientStatusPID" ] && [ "$curClientStatusPID" = "$fileClientStatusPID" ]; then
		/usr/bin/killall MPClientStatus
	else
		rm -f /private/tmp/clientStatusPID
	fi
fi

# ******************************************************************
# Summary
#
if [ "$LOAD_FAILED" -ne 0 ]; then
	echo "Warning: one or more MacPatch daemons failed to load. See messages above."
	echo "         Check: sudo launchctl print system/gov.llnl.mp.helper"
	# To make a failed daemon load fail the package install, change the
	# exit below to: exit "$LOAD_FAILED"
else
	echo "All MacPatch daemons loaded."
fi

exit 0;
